# ==============================================================================
# AI Video Assistant - Environment Configuration
# ==============================================================================

# Mistral AI API Key (Required for Title, Summarization, Extraction, and RAG Chat)
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Required only if transcribing 'hinglish' / Indic audio)
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Whisper Model Size (Default: small)
# Options: tiny, base, small, medium, large
WHISPER_MODEL=small

# Optional: Sarvam STT Model Identifier (Default: saaras:v2.5)
SARVAM_STT_MODEL=saaras:v2.5
